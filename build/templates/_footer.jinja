  <footer class="bg-dark text-white py-5">
    <div class="container">
      <div class="row g-4 text-center mb-5">
        <div class="col-md-4">
          <h2 class="h5 fw-bold">Services</h2>
          <div class="accent-bar mx-auto mb-3"></div>
          <ul class="list-unstyled mb-0">
            {% for slug, page in pages.items() | sort if page.page_type == "service" %}
            <li class="mb-1"><a class="link-light text-decoration-none" href="{{ page.canonical_path }}">{{ page.nav_label }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="col-md-4">
          <h2 class="h5 fw-bold">Locations</h2>
          <div class="accent-bar mx-auto mb-3"></div>
          <ul class="list-unstyled mb-0">
            {% for slug, page in pages.items() | sort if page.page_type == "location" %}
            <li class="mb-1"><a class="link-light text-decoration-none" href="{{ page.canonical_path }}">{{ page.nav_label }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="col-md-4">
          <h2 class="h5 fw-bold">More</h2>
          <div class="accent-bar mx-auto mb-3"></div>
          <ul class="list-unstyled mb-0">
            <li class="mb-1"><a class="link-light text-decoration-none" href="/projects/">Projects</a></li>
            <li class="mb-1"><a class="link-light text-decoration-none" href="/resources/">Resources</a></li>
          </ul>
        </div>
      </div>

      <div class="row g-4 text-center">
        <div class="col-md-4 d-flex align-items-center justify-content-center">
          <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width:190px; height:190px;">
            <img src="/assets/logo-with-hero.png" alt="Lifetime Garage Flooring logo" class="img-fluid" style="max-height:170px; max-width:170px;" width="170" height="96" loading="lazy"
                 onerror="this.style.display='none'; document.getElementById('footerFallback').classList.remove('d-none');">
            <span id="footerFallback" class="fw-bold text-dark d-none">Lifetime Garage Flooring</span>
          </div>
        </div>

        <div class="col-md-4">
          <h2 class="h5 fw-bold">Get In Touch</h2>
          <div class="accent-bar mx-auto mb-3"></div>

          <p class="mb-1"><strong class="text-gold">Address:</strong> {{ business_address.street }} {{ business_address.locality }}, {{ business_address.region }} {{ business_address.postal_code }}</p>
          <p class="mb-1"><strong class="text-gold">Phone:</strong> <a href="tel:{{ business_phone }}" class="link-light text-decoration-none">{{ business_phone_display }}</a></p>
          <p class="mb-3"><strong class="text-gold">Email:</strong> <a href="mailto:info@technifloors.com" class="link-light text-decoration-none">info@technifloors.com</a></p>

          <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
            <a class="btn btn-light" href="tel:{{ business_phone }}"><i class="bi bi-telephone-fill me-1"></i>Call Now</a>
            <a class="btn btn-outline-light" href="#contact">Free Estimate</a>
          </div>
        </div>

        <div class="col-md-4">
          <h2 class="h5 fw-bold">Follow Us</h2>
          <div class="accent-bar mx-auto mb-3"></div>

          <div class="d-flex justify-content-center gap-3">
            <a href="https://www.linkedin.com/company/lifetime-garage-flooring" target="_blank" aria-label="LinkedIn" class="social-icon"><i class="bi bi-linkedin"></i></a>
            <a href="#" aria-label="Facebook" class="social-icon d-none"><i class="bi bi-facebook"></i></a>
            <a href="#" aria-label="YouTube" class="social-icon d-none"><i class="bi bi-youtube"></i></a>
            <a href="#" aria-label="X" class="social-icon d-none"><i class="bi bi-twitter-x"></i></a>
          </div>
        </div>
      </div>

      <p class="text-center small border-top border-light border-opacity-25 pt-3 mt-5 mb-0 text-white-50">
        &copy; <span id="year"></span> Lifetime Garage Flooring. A Technifloors Brand.
      </p>
    </div>
  </footer>
