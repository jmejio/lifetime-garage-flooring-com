  <header class="sticky-top bg-white shadow-sm border-bottom" id="header">
    <div class="container py-2">
      <div class="row align-items-start gy-2">

        <!-- Left column: logo -->
        <div class="col-auto">
          <a href="{{ logo_href }}" class="navbar-brand d-flex align-items-center mb-0">
            <img src="/assets/logo-with-hero.png" alt="Lifetime Garage Flooring logo" class="brand-logo me-2" width="141" height="79"
                 onerror="this.style.display='none'; document.getElementById('brandFallback').classList.remove('d-none');">
            <span id="brandFallback" class="fw-bold d-none">Lifetime Garage Flooring</span>
          </a>
        </div>

        <!-- Center column: tagline -->
        <div class="col d-flex justify-content-center align-items-center pt-3 px-2">
          <span class="d-none d-xl-inline-flex align-items-center text-gold fw-semibold small text-center" style="max-width:340px;">
            <i class="bi bi-heart-fill me-2"></i>We offer discounts for Seniors, First Responders, Teachers, and Persons with Disabilities
          </span>
        </div>

        <!-- Right column: call-to-action buttons + navigation menu -->
        <div class="col-auto">
          <div class="d-flex flex-column align-items-end gap-2">
            <div class="d-flex align-items-center gap-1 gap-sm-2">
              <a class="btn btn-outline-primary btn-sm" href="tel:{{ business_phone }}" aria-label="Call {{ business_phone_display }}">
                <i class="bi bi-telephone-fill"></i>
                <span class="d-none d-sm-inline ms-1">{{ business_phone_display }}</span>
              </a>
              <a class="btn btn-primary btn-sm d-none d-md-inline-flex align-items-center" href="#contact">
                Get a Free Quote
              </a>

              <button class="btn btn-outline-primary btn-sm d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                      aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-5"></i>
              </button>
            </div>

            <nav class="navbar navbar-expand-md p-0 position-relative">
              <div class="collapse navbar-collapse justify-content-end" id="navMenu">
                <ul class="navbar-nav gap-md-3 align-items-end align-items-md-center">
                  <li class="nav-item"><a class="nav-link" href="/about.html">About Us</a></li>
                  <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navServicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Services</a>
                    <ul class="dropdown-menu" aria-labelledby="navServicesDropdown">
                      {% for slug, page in pages.items() | sort if page.page_type == "service" %}
                      <li><a class="dropdown-item" href="{{ page.canonical_path }}">{{ page.nav_label }}</a></li>
                      {% endfor %}
                    </ul>
                  </li>
                  <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navLocationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Locations</a>
                    <ul class="dropdown-menu" aria-labelledby="navLocationsDropdown">
                      {% for slug, page in pages.items() | sort if page.page_type == "location" %}
                      <li><a class="dropdown-item" href="{{ page.canonical_path }}">{{ page.nav_label }}</a></li>
                      {% endfor %}
                      <li><hr class="dropdown-divider"></li>
                      <li><a class="dropdown-item fw-semibold" href="/locations/">View All Locations</a></li>
                    </ul>
                  </li>
                  <li class="nav-item"><a class="nav-link" href="/projects/">Projects</a></li>
                  <li class="nav-item"><a class="nav-link" href="/resources/">Resources</a></li>
                  <li class="nav-item"><a class="nav-link" href="/index.html#why-us">Why Us</a></li>
                  <li class="nav-item"><a class="nav-link" href="/index.html#contact">Contact</a></li>
                  <li class="nav-item d-md-none"><a class="btn btn-primary btn-sm" href="/index.html#contact">Free Estimate</a></li>
                </ul>
              </div>
            </nav>
          </div>
        </div>

      </div>
    </div>
  </header>
