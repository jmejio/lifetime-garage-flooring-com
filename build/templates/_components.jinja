{# Reusable content-section macros for service/location/project/resource pages.
   Every macro takes simple data-in (lists/dicts of strings) and emits
   Bootstrap-utility-class markup consistent with the existing site styling —
   no new custom CSS required. photo_cards, checklist_with_image, and
   image_carousel are generic enough for any page, not just the homepage. #}

{% macro benefits_grid(items) %}
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 text-start">
  {% for item in items %}
  <div class="col">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <i class="bi {{ item.icon }} fs-2 text-gold mb-3"></i>
        <h3 class="h5 card-title text-primary">{{ item.title }}</h3>
        <p class="card-text text-muted mb-0">{{ item.text }}</p>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endmacro %}

{% macro photo_cards(items) %}
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 text-start">
  {% for item in items %}
  <div class="col">
    <div class="card h-100 border-0 shadow-sm">
      <img src="{{ item.src }}" class="card-img-top" alt="{{ item.alt }}" width="{{ item.width }}" height="{{ item.height }}" loading="lazy">
      <div class="card-body">
        <h3 class="h5 card-title text-primary">{{ item.title }}</h3>
        <p class="card-text text-muted">{{ item.text }}</p>
        {% if item.href %}
        <a href="{{ item.href }}" class="small fw-semibold">Learn More <i class="bi bi-arrow-right"></i></a>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endmacro %}

{% macro checklist_with_image(image, alt, width, height, items, heading=none) %}
<div class="row justify-content-center align-items-center g-4 text-center">
  <div class="col-auto">
    <img src="{{ image }}" alt="{{ alt }}" class="img-fluid" style="max-width:130px;" width="{{ width }}" height="{{ height }}" loading="lazy">
  </div>
  <div class="col-12 col-md-6">
    {% if heading %}
    <h2 class="fw-bold">{{ heading }}</h2>
    <div class="accent-bar mx-auto mb-4"></div>
    {% endif %}
    <ul class="list-unstyled text-start d-inline-block mx-auto" style="max-width:340px;">
      {% for item in items %}
      <li class="d-flex align-items-center gap-2{{ '' if loop.last else ' mb-3' }}">
        <i class="bi bi-check-circle-fill text-gold"></i>{{ item }}
      </li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endmacro %}

{% macro image_carousel(carousel_id, images) %}
<div id="{{ carousel_id }}" class="carousel slide shadow-sm" data-bs-ride="carousel">
  <div class="carousel-indicators">
    {% for image in images %}
    <button type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide-to="{{ loop.index0 }}"{% if loop.first %} class="active" aria-current="true"{% endif %} aria-label="Slide {{ loop.index }}"></button>
    {% endfor %}
  </div>
  <div class="carousel-inner">
    {% for image in images %}
    <div class="carousel-item{% if loop.first %} active{% endif %}">
      <img src="{{ image.src }}" class="d-block w-100 gallery-img" alt="{{ image.alt }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy">
    </div>
    {% endfor %}
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
{% endmacro %}

{% macro process_steps(steps) %}
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 text-center">
  {% for step in steps %}
  <div class="col">
    <div class="d-flex flex-column align-items-center">
      <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold mb-3" style="width:48px;height:48px;">
        {{ loop.index }}
      </div>
      <h3 class="h6 fw-bold">{{ step.title }}</h3>
      <p class="text-muted small mb-0">{{ step.text }}</p>
    </div>
  </div>
  {% endfor %}
</div>
{% endmacro %}

{% macro faq_accordion(qa_list, id_prefix="faq") %}
{% if qa_list %}
<div class="accordion" id="{{ id_prefix }}Accordion">
  {% for qa in qa_list %}
  <div class="accordion-item">
    <h3 class="accordion-header" id="{{ id_prefix }}Heading{{ loop.index }}">
      <button class="accordion-button{{ '' if loop.first else ' collapsed' }}" type="button" data-bs-toggle="collapse"
              data-bs-target="#{{ id_prefix }}Collapse{{ loop.index }}" aria-expanded="{{ 'true' if loop.first else 'false' }}"
              aria-controls="{{ id_prefix }}Collapse{{ loop.index }}">
        {{ qa.question }}
      </button>
    </h3>
    <div id="{{ id_prefix }}Collapse{{ loop.index }}" class="accordion-collapse collapse{{ ' show' if loop.first else '' }}"
         aria-labelledby="{{ id_prefix }}Heading{{ loop.index }}" data-bs-parent="#{{ id_prefix }}Accordion">
      <div class="accordion-body text-muted">
        {{ qa.answer }}
      </div>
    </div>
  </div>
  {% endfor %}
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for qa in qa_list %}
    {
      "@type": "Question",
      "name": {{ qa.question | tojson }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ qa.answer | tojson }}
      }
    }{{ "," if not loop.last }}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endmacro %}

{% macro testimonial_quote(text, author) %}
<blockquote class="border-start border-4 border-primary ps-4 py-2 fst-italic text-muted">
  <p class="mb-2">&ldquo;{{ text }}&rdquo;</p>
  <footer class="blockquote-footer text-gold fst-normal fw-semibold">{{ author }}</footer>
</blockquote>
{% endmacro %}

{% macro cta_band(text, href, button_label="Get a Free Estimate", section_id=none) %}
<section class="bg-primary text-white py-5 text-center"{% if section_id %} id="{{ section_id }}"{% endif %}>
  <div class="container">
    <h2 class="fw-bold mb-3">{{ text }}</h2>
    <a class="btn btn-light btn-lg" href="{{ href }}">{{ button_label }}</a>
  </div>
</section>
{% endmacro %}

{# JSON-LD schema macros below read canonical_url/og_image/description from the
   calling page's render context (imported "with context") and business_phone/
   business_address from environment globals — callers only need to pass the
   handful of fields that actually vary per page. #}

{% macro local_business_schema(name, area_served) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": {{ name | tojson }},
  "image": {{ og_image | tojson }},
  "telephone": {{ business_phone | tojson }},
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ business_address.street | tojson }},
    "addressLocality": {{ business_address.locality | tojson }},
    "addressRegion": {{ business_address.region | tojson }},
    "postalCode": {{ business_address.postal_code | tojson }},
    "addressCountry": {{ business_address.country | tojson }}
  },
  "areaServed": {{ area_served | tojson }},
  "url": {{ canonical_url | tojson }}
}
</script>
{%- endmacro %}

{% macro service_schema(name, service_type, description) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ name | tojson }},
  "serviceType": {{ service_type | tojson }},
  "description": {{ description | tojson }},
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "Lifetime Garage Flooring",
    "telephone": {{ business_phone | tojson }},
    "url": {{ (site_base_url ~ "/") | tojson }}
  },
  "areaServed": "Tampa Bay area, FL",
  "url": {{ canonical_url | tojson }}
}
</script>
{%- endmacro %}

{% macro article_schema(headline, date_published) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ headline | tojson }},
  "description": {{ description | tojson }},
  "image": {{ og_image | tojson }},
  "datePublished": {{ date_published | tojson }},
  "author": {
    "@type": "Organization",
    "name": "Lifetime Garage Flooring"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Lifetime Garage Flooring",
    "logo": {
      "@type": "ImageObject",
      "url": {{ (site_base_url ~ "/assets/logo-with-hero.png") | tojson }}
    }
  },
  "mainEntityOfPage": {{ canonical_url | tojson }}
}
</script>
{%- endmacro %}

{% macro contact_form() %}
<section class="py-5 bg-light" id="contact">
  <div class="container" style="max-width:420px;">
    <h2 class="fw-bold text-center">Request a Free Quote</h2>
    <div class="accent-bar mx-auto mb-4"></div>

    <div id="qfFormWrap">
      <form id="quoteForm" novalidate>
        <input type="hidden" name="access_key" value="{{ web3forms_access_key }}">
        <input type="hidden" name="subject" value="New Quote Request - Lifetime Garage Flooring">
        <input type="checkbox" name="botcheck" class="d-none" style="display:none" tabindex="-1" autocomplete="off">

        <div id="qfStep1">
          <p class="text-muted small mb-3">We offer free estimates on residential garage flooing. Fill out the form below to request your complimentary consultation. </p>
          <div class="row mb-3 align-items-center">
            <label for="qfName" class="col-4 col-form-label">Name</label>
            <div class="col-8">
              <input type="text" class="form-control" id="qfName" name="name" required>
            </div>
          </div>

          <div class="row mb-3 align-items-center">
            <label for="qfEmail" class="col-4 col-form-label">Email</label>
            <div class="col-8">
              <input type="email" class="form-control" id="qfEmail" name="email" required>
            </div>
          </div>

          <div class="row mb-3 align-items-center">
            <label for="qfPhone" class="col-4 col-form-label">Phone</label>
            <div class="col-8">
              <input type="tel" class="form-control" id="qfPhone" name="phone">
            </div>
          </div>

          <button type="button" class="btn btn-primary btn-lg w-100" id="qfNext">Submit</button>
        </div>

        <div id="qfStep2" class="d-none">
          <p class="text-muted small mb-3">One more thing...</p>

          <div class="row mb-3">
            <label for="qfMessage" class="col-4 col-form-label">Tell us about your garage</label>
            <div class="col-8">
              <textarea class="form-control" id="qfMessage" name="message" rows="4" required></textarea>
            </div>
          </div>

          <div id="qfStatus" role="status" aria-live="polite" class="mb-3"></div>

          <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" id="qfBack">Back</button>
            <button type="submit" class="btn btn-primary btn-lg flex-grow-1" id="qfSubmit">Send Request</button>
          </div>
        </div>
      </form>

      <p class="text-muted small text-center mt-3 mb-0">
        <i class="bi bi-shield-lock-fill me-1"></i>
        Your privacy matters to us. Information submitted here is used solely to respond to your quote request and is never sold or shared with third parties.
      </p>
    </div>

    <div id="qfThankYou" class="d-none text-center py-4" role="status" aria-live="polite">
      <i class="bi bi-check-circle-fill text-primary fs-1 mb-3 d-block"></i>
      <h3 class="h4 fw-bold mb-2">Thank you!</h3>
      <p class="text-muted mb-0">We got your request and will be in touch shortly. <br>If it's urgent, call us at
        <a href="tel:{{ business_phone }}" class="link-primary text-decoration-none">{{ business_phone_display }}</a>.</p>
    </div>
  </div>
</section>
{% endmacro %}

{% macro related_links(title, items, section_id=none) %}
{% if items %}
<section class="py-5 bg-light"{% if section_id %} id="{{ section_id }}"{% endif %}>
  <div class="container text-center">
    <h2 class="h4 fw-bold">{{ title }}</h2>
    <div class="accent-bar mx-auto mb-4"></div>
    <ul class="list-unstyled d-flex flex-wrap justify-content-center gap-3 mb-0">
      {% for item in items %}
      <li><a class="btn btn-outline-primary" href="{{ item.href }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
{% endmacro %}
