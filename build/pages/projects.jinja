{% extends "base.jinja" %}
{% import "_components.jinja" as components with context %}
{% block content %}
  <main>

    <section class="container py-5" id="intro">
      <div class="row">
        <div class="col-lg-8">
          <h1 class="display-5 fw-bold text-primary mb-3">Our Projects</h1>
          <div class="accent-bar mb-4"></div>
          <p class="lead text-muted">
            Real garage floor coating projects completed for homeowners across
            the Tampa Bay area. Browse recent work below.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-light py-5" id="project-list">
      <div class="container">
        {% set project_items = [] %}
        {% for slug, page in pages.items() | sort if page.page_type == "project" %}
        {% set _ = project_items.append({
          "href": page.canonical_path,
          "title": page.title.split(" | ")[0],
          "location": page.location,
          "service": page.service,
          "square_footage": page.square_footage,
          "scope_summary": page.scope_summary,
          "src": page.card_image,
          "alt": page.card_image_alt,
          "width": page.card_image_width,
          "height": page.card_image_height
        }) %}
        {% endfor %}
        {{ components.project_cards(project_items) }}
      </div>
    </section>

  </main>
{% endblock %}
