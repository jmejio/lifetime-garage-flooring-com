{% extends "base.jinja" %}
{% import "_components.jinja" as components with context %}

{% block extra_schema %}
{{ components.local_business_schema("Lifetime Garage Flooring - Orlando, FL", "Orlando, FL") }}
{% endblock %}

{% block content %}
  <main id="top">

    <section class="container py-5">
      <div class="row">
        <div class="col-lg-8">
          <h1 class="display-5 fw-bold text-primary mb-3">Garage Floor Coating in Orlando, FL</h1>
          <div class="accent-bar mb-4"></div>
          <p class="lead text-muted">
            Located in Orange County along the I-4 corridor in Central Florida,
            Orlando is one of the communities we travel to regularly. We install
            epoxy and polyaspartic garage floor coatings built to handle the
            same Florida heat and humidity Orlando homeowners deal with
            year-round.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-light py-5" id="benefits">
      <div class="container text-center">
        <h2 class="fw-bold">Why Orlando Homeowners Choose Us</h2>
        <div class="accent-bar mx-auto mb-4"></div>
        {{ components.benefits_grid([
          {"icon": "bi-geo-alt-fill", "title": "Serving Orlando & Orange County", "text": "We regularly travel to Orlando for garage floor coating installations and estimates."},
          {"icon": "bi-shield-check", "title": "Built for Florida Garages", "text": "Coatings designed to handle Florida humidity, heat, and daily driveway-to-garage traffic."},
          {"icon": "bi-clock-history", "title": "Fast Turnaround", "text": "Most Orlando garages are coated and ready to use in as little as a day."},
          {"icon": "bi-award", "title": "Lifetime Warranty", "text": "Every installation, anywhere in Orlando, is backed by our lifetime warranty."}
        ]) }}
      </div>
    </section>

    {{ components.cta_band("Get a Free Estimate in Orlando", "#contact") }}

    <section class="py-5" id="faq">
      <div class="container" style="max-width:800px;">
        <h2 class="fw-bold text-center">Orlando Garage Flooring FAQs</h2>
        <div class="accent-bar mx-auto mb-4"></div>
        {{ components.faq_accordion([
          {"question": "Do you serve homeowners in Orlando?", "answer": "Yes — we regularly install garage floor coatings for homeowners throughout Orlando and Orange County."},
          {"question": "How quickly can you install a garage floor coating in Orlando?", "answer": "Most Orlando garages are turned around in about a day; scheduling is coordinated around our Orlando service visits."},
          {"question": "Do you offer free estimates in Orlando?", "answer": "Yes. We offer free, no-obligation estimates for Orlando homeowners."},
          {"question": "What garage floor coating options are available?", "answer": "We install epoxy and polyaspartic concrete coating systems for Orlando homeowners, both backed by a lifetime warranty."}
        ], id_prefix="orlandoFaq") }}
      </div>
    </section>

    {{ components.related_links("Explore Our Services", related_services) }}

  </main>

  {{ components.contact_form() }}
{% endblock %}
