{% extends "base.jinja" %}
{% block content %}
  <main id="top">

    <section class="container py-5">
      <div class="row">
        <div class="col-lg-8">
          <h1 class="display-5 fw-bold text-primary mb-3">Where We Serve</h1>
          <div class="accent-bar mb-4"></div>
          <p class="lead text-muted">
            Lifetime Garage Flooring installs epoxy and polyaspartic garage floor
            coatings for homeowners across the Tampa Bay area. We're building out
            a dedicated page for every city we serve — here's what's available today.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-light py-5">
      <div class="container">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 text-start">
          {% for slug, page in pages.items() | sort if page.page_type == "location" %}
          <div class="col">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body">
                <h2 class="h5 card-title text-primary">{{ page.title.split(" | ")[0] }}</h2>
                <p class="card-text text-muted">{{ page.description }}</p>
                <a href="{{ page.canonical_path }}" class="small fw-semibold">Learn More <i class="bi bi-arrow-right"></i></a>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

  </main>
{% endblock %}
