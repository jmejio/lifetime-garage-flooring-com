{% extends "base.jinja" %}
{% block content %}
  <main id="top">

    <section class="hero-section d-flex align-items-center">
      <div class="container">
        <div class="hero-content">
          <p class="hero-eyebrow mb-2">Durable&nbsp;&nbsp;/&nbsp;&nbsp;Beautiful&nbsp;&nbsp;/&nbsp;&nbsp;Built to Last</p>
          <h1 class="display-4 fw-bold text-white mb-3">Transform Your Garage with <br><span class="text-gold-light">Epoxy Flooring</span></h1>
          <p class="lead hero-subtext mb-4">
            Get a garage floor that looks amazing, stands up to daily use,
            and adds lasting value to your home.
          </p>

          <div class="d-flex flex-column flex-sm-row gap-3 mb-5">
            <a class="btn btn-primary btn-lg" href="#contact">
              Get a Free Estimate<i class="bi bi-arrow-right ms-2"></i>
            </a>
            <a class="btn btn-outline-light btn-lg" href="tel:+18132134050">
              <i class="bi bi-telephone-fill me-2"></i>Call Now
            </a>
          </div>

          <div class="d-flex flex-wrap flex-lg-nowrap gap-3 gap-xl-4 hero-badges">
            <div class="d-flex align-items-center gap-2 text-white text-nowrap">
              <i class="bi bi-shield-check fs-4 text-gold-light"></i>
              <span>Durable &amp; Long Lasting</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-white text-nowrap">
              <i class="bi bi-stars fs-4 text-gold-light"></i>
              <span>Easy to Clean &amp; Maintain</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-white text-nowrap">
              <i class="bi bi-house-door-fill fs-4 text-gold-light"></i>
              <span>Residential &amp; Commercial</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-light py-5" id="services">
      <div class="container text-center">
        <h2 class="fw-bold">Our Services</h2>
        <div class="accent-bar mx-auto mb-4"></div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 text-start">
          <div class="col">
            <div class="card h-100 border-0 shadow-sm">
              <img src="assets/epoxy-coating.jpg" class="card-img-top" alt="Epoxy garage floor coating" width="768" height="576" loading="lazy">
              <div class="card-body">
                <h3 class="h5 card-title text-primary">Epoxy Coatings</h3>
                <p class="card-text text-muted">Chemical- and impact-resistant epoxy systems built for daily garage use.</p>
              </div>
            </div>
          </div>
          <div class="col">
            <div class="card h-100 border-0 shadow-sm">
              <img src="assets/polyaspartic-coating.jpg" class="card-img-top" alt="Polyaspartic garage floor coating" width="1024" height="768" loading="lazy">
              <div class="card-body">
                <h3 class="h5 card-title text-primary">Polyaspartic Coatings</h3>
                <p class="card-text text-muted">Fast-curing, UV-stable finish — most garages are ready to use in a day.</p>
              </div>
            </div>
          </div>
          <div class="col">
            <div class="card h-100 border-0 shadow-sm">
              <img src="assets/decorative-flake.jpg" class="card-img-top" alt="Decorative flake garage floor system" width="570" height="708" loading="lazy">
              <div class="card-body">
                <h3 class="h5 card-title text-primary">Decorative Flake Systems</h3>
                <p class="card-text text-muted">Custom color flake blends for a durable, showroom-quality look.</p>
              </div>
            </div>
          </div>
          <div class="col">
            <div class="card h-100 border-0 shadow-sm">
              <img src="assets/concrete-repair.jpg" class="card-img-top" alt="Garage concrete repair and prep" width="450" height="250" loading="lazy">
              <div class="card-body">
                <h3 class="h5 card-title text-primary">Concrete Repair &amp; Prep</h3>
                <p class="card-text text-muted">Crack repair, grinding, and surface prep for a long-lasting finish.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5" id="why-us">
      <div class="container">
        <div class="row justify-content-center align-items-center g-4 text-center">
          <div class="col-auto">
            <img src="assets/hero-standing.png" alt="Lifetime Garage Flooring mascot" class="img-fluid" style="max-width:130px;" width="207" height="349" loading="lazy">
          </div>
          <div class="col-12 col-md-6">
            <h2 class="fw-bold">Why Choose Us</h2>
            <div class="accent-bar mx-auto mb-4"></div>

            <ul class="list-unstyled text-start d-inline-block mx-auto" style="max-width:340px;">
              <li class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-check-circle-fill text-gold"></i>Lifetime warranty on every installation
              </li>
              <li class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-check-circle-fill text-gold"></i>Locally owned and operated in Lutz, FL
              </li>
              <li class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-check-circle-fill text-gold"></i>Fast turnaround — most garages done in a day
              </li>
              <li class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-gold"></i>Licensed and insured professionals
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-light py-5" id="gallery">
      <div class="container" style="max-width:800px;">
        <h2 class="fw-bold text-center">Get Inspired</h2>
        <div class="accent-bar mx-auto mb-4"></div>

        <div id="inspirationCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
          <div class="carousel-indicators">
            <button type="button" data-bs-target="#inspirationCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#inspirationCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#inspirationCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
          </div>
          <div class="carousel-inner">
            <div class="carousel-item active">
              <img src="assets/gallery-1.jpg" class="d-block w-100 gallery-img" alt="Finished garage floor project" width="768" height="576" loading="lazy">
            </div>
            <div class="carousel-item">
              <img src="assets/gallery-2.jpg" class="d-block w-100 gallery-img" alt="Finished garage floor project" width="768" height="960" loading="lazy">
            </div>
            <div class="carousel-item">
              <img src="assets/gallery-3.jpg" class="d-block w-100 gallery-img" alt="Finished garage floor project" width="768" height="576" loading="lazy">
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#inspirationCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#inspirationCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>
    </section>

  </main>

  <div id="contact-form-root"></div>
{% endblock %}
