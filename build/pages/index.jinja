{% extends "base.jinja" %}
{% import "_components.jinja" as components with context %}
{% block content %}
  <main id="top">

    <section class="hero-section d-flex align-items-center">
      <div class="container">
        <div class="hero-content">
          <p class="hero-eyebrow mb-2">Durable&nbsp;&nbsp;/&nbsp;&nbsp;Beautiful&nbsp;&nbsp;/&nbsp;&nbsp;Built to Last</p>
          <h1 class="display-4 fw-bold text-white mb-3">Transform Your Garage with <br><span class="text-gold-light">Epoxy Flooring</span></h1>
          <p class="lead hero-subtext mb-4">
            Get a garage floor that looks amazing, stands up to daily use,
            and adds lasting value to your home. Proudly serving homeowners
            across the Tampa Bay area.
          </p>

          <div class="d-flex flex-column flex-sm-row gap-3 mb-5">
            <a class="btn btn-primary btn-lg" href="#contact">
              Get a Free Estimate<i class="bi bi-arrow-right ms-2"></i>
            </a>
            <a class="btn btn-outline-light btn-lg" href="tel:+18132134050">
              <i class="bi bi-telephone-fill me-2"></i>Call Now
            </a>
          </div>

          <div class="d-flex flex-wrap flex-lg-nowrap gap-3 gap-xl-4 hero-badges">
            <div class="d-flex align-items-center gap-2 text-white text-nowrap">
              <i class="bi bi-shield-check fs-4 text-gold-light"></i>
              <span>Durable &amp; Long Lasting</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-white text-nowrap">
              <i class="bi bi-stars fs-4 text-gold-light"></i>
              <span>Easy to Clean &amp; Maintain</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-white text-nowrap">
              <i class="bi bi-house-door-fill fs-4 text-gold-light"></i>
              <span>Residential Garage Specialists</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-light py-5" id="services">
      <div class="container text-center">
        <h2 class="fw-bold">Our Services</h2>
        <div class="accent-bar mx-auto mb-4"></div>
        {{ components.photo_cards([
          {"src": "/assets/epoxy-coating.jpg", "alt": "Epoxy garage floor coating", "width": 768, "height": 576, "title": "Epoxy Coatings", "text": "Chemical- and impact-resistant epoxy systems built for daily garage use.", "href": "/services/epoxy-flooring/"},
          {"src": "/assets/polyaspartic-coating.jpg", "alt": "Polyaspartic garage floor coating", "width": 1024, "height": 768, "title": "Polyaspartic Coatings", "text": "Fast-curing, UV-stable finish — most garages are ready to use in a day.", "href": "/services/concrete-coating/"},
          {"src": "/assets/decorative-flake.jpg", "alt": "Decorative flake garage floor system", "width": 570, "height": 708, "title": "Decorative Flake Systems", "text": "Custom color flake blends for a durable, showroom-quality look."},
          {"src": "/assets/concrete-repair.jpg", "alt": "Garage concrete repair and prep", "width": 450, "height": 250, "title": "Concrete Repair &amp; Prep", "text": "Crack repair, grinding, and surface prep for a long-lasting finish."}
        ]) }}
      </div>
    </section>

    <section class="py-5" id="why-us">
      <div class="container">
        {{ components.checklist_with_image(
          "/assets/hero-standing.png", "Lifetime Garage Flooring mascot", 207, 349,
          [
            "Lifetime warranty on every installation",
            "Locally owned and operated, headquartered in Lutz, FL. Proudly serving the Tampa Bay area",
            "Fast turnaround — most garages done in a day",
            "Licensed and insured professionals"
          ],
          heading="Why Choose Us"
        ) }}
      </div>
    </section>

    <section class="bg-light py-5" id="gallery">
      <div class="container" style="max-width:800px;">
        <h2 class="fw-bold text-center">Get Inspired</h2>
        <div class="accent-bar mx-auto mb-4"></div>
        {{ components.image_carousel("inspirationCarousel", [
          {"src": "/assets/gallery-1.jpg", "alt": "Finished garage floor project", "width": 768, "height": 576},
          {"src": "/assets/gallery-2.jpg", "alt": "Finished garage floor project", "width": 768, "height": 960},
          {"src": "/assets/gallery-3.jpg", "alt": "Finished garage floor project", "width": 768, "height": 576}
        ]) }}
      </div>
    </section>

    <section class="py-5">
      <div class="container" style="max-width:700px;">
        {{ components.testimonial_quote(
          "We stand behind every floor we install with a lifetime warranty, because we don't cut corners on prep or materials — just honest, quality work that holds up to real garage use.",
          "Lifetime Garage Flooring"
        ) }}
      </div>
    </section>

    {{ components.cta_band("Ready for a Beautiful, Durable Garage Floor?", "#contact") }}

    <section class="bg-light py-5" id="faq">
      <div class="container" style="max-width:800px;">
        <h2 class="fw-bold text-center">Frequently Asked Questions</h2>
        <div class="accent-bar mx-auto mb-4"></div>
        {{ components.faq_accordion([
          {"question": "What areas do you serve?", "answer": "We're headquartered in Lutz, FL and proudly serve homeowners throughout the Tampa Bay area, including Tampa, St. Petersburg, Lakeland, and Orlando."},
          {"question": "What's the difference between epoxy and polyaspartic coatings?", "answer": "Epoxy offers a thick, durable build with a wide range of decorative flake options, while polyaspartic cures faster and holds up better to UV exposure. We'll help you choose the right system for your garage."},
          {"question": "How long does installation take?", "answer": "Most residential garages are coated and ready to use in as little as a day, depending on the system and any concrete repair needed."},
          {"question": "Is your work guaranteed?", "answer": "Yes. Every installation is backed by our lifetime warranty and performed by licensed, insured professionals."}
        ], id_prefix="homeFaq") }}
      </div>
    </section>

  </main>

  {{ components.contact_form() }}
{% endblock %}
